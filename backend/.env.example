# Backend (.env) example

# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# CORS
# Frontend origin that is allowed to call this API and receive cookies
FRONTEND_ORIGIN=http://localhost:3000
# Allow cookies/credentials for CORS
CORS_ALLOW_CREDENTIALS=true

# Cookies / JWT
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=8h
SESSION_COOKIE_NAME=dt3_session
# For local dev with http use false; set true in production over https
COOKIE_SECURE=false
# SameSite can be lax, strict, or none (use none only with https and secure cookies)
COOKIE_SAMESITE=lax
# Optional cookie domain (unset for localhost)
# COOKIE_DOMAIN=.example.com

# Authentication
# Enable mock login endpoint /auth/mock/login
MOCK_AUTH=true
# Placeholders for future SSO providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
OAUTH_CALLBACK_BASE_URL=

# Database (MongoDB)
# To run without DB leave empty (endpoints that need DB will be limited)
MONGODB_URI=mongodb://localhost:27017/digitalt3

# Seed admin (used by `npm run seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin User

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
