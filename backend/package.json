{
  "name": "digitalt3-backend",
  "version": "1.0.0",
  "description": "DigitalT3 Weekly Report Platform - Backend APIs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
